---
import Base from '~/layouts/Base.astro';
import LegalFrame from '~/components/LegalFrame.astro';
import { games } from '~/data/products';
interface Frontmatter{title:string;description:string;path:string;effective:string;updated:string;applies_to:string}
const {frontmatter,headings=[]}=Astro.props as {frontmatter:Frontmatter;headings:{depth:number;slug:string;text:string}[]};
const game=games.find(p=>p.slug===frontmatter.path.split('/').filter(Boolean)[0]);
if(!game)throw new Error('Game data missing for legal page');
---
<Base locale="en" title={frontmatter.title} description={frontmatter.description} path={frontmatter.path} localized={false}>
  <LegalFrame product={game} title={frontmatter.title.replace(` — ${game.name}`,'')} current={frontmatter.path.endsWith('/terms')?'terms':'privacy'} updated={frontmatter.updated} effective={frontmatter.effective} applies={frontmatter.applies_to} headings={headings.filter(h=>h.depth===2)}><slot/></LegalFrame>
</Base>
