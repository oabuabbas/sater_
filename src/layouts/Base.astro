---
import "~/styles/tokens.css";
import "~/styles/base.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import ScribeMotion from "~/components/ScribeMotion.astro";
import { dir, useTranslations, localizePath, type UIKey } from "~/i18n/ui";
import { tools, games, studioLinks, type Locale } from "~/data/products";
import { seoPages, productDiscovery } from "~/data/discovery";

interface Props {
  locale: Locale;
  /** Page title without the brand — the layout appends it. */
  title: string;
  description?: string;
  /** Path with no locale prefix, e.g. "/tools". Drives the language switch. */
  path: string;
  /** False for English-only legal/product pages that have no Arabic twin. */
  localized?: boolean;
  structuredData?: Record<string, unknown>[];
}

const { locale, title, description, path, localized = true, structuredData = [] } = Astro.props;
const t = useTranslations(locale);

const site = Astro.site ?? new URL("https://thesater.com");
const canonical = new URL(localizePath(path, locale), site);

// The old site wrote these as Markdown links inside href attributes, so the
// fonts never loaded and every shared link rendered without an image. Absolute
// URLs, built from Astro.site, are the fix.
const cleanPath = path.replace(/\/$/, '') || '/';
const product = [...tools, ...games].find(p => cleanPath === `/${p.slug}`);
const seo = seoPages[cleanPath];
const heading = seo?.title[locale] ?? (product ? `${product.name} — ${productDiscovery[product.slug].purpose[locale]}` : title);
const ogImage = new URL(product?.feature?.src ?? '/cover.png', site);
const pageTitle = /^SATER\b/.test(heading) ? heading : `${heading} | SATER`;
const desc = description ?? seo?.description[locale] ?? (product ? productDiscovery[product.slug].body[locale] : t("site.description" as UIKey));
const websiteId = new URL('/#website', site).href;
const studioId = new URL('/#studio', site).href;
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': studioId, name: 'SATER', alternateName: 'سطر', url: site.href,
    logo: new URL('/favicon.png', site).href, sameAs: Object.values(studioLinks) },
  { '@type': 'WebSite', '@id': websiteId, name: 'SATER', alternateName: 'سطر', url: site.href,
    inLanguage: ['en', 'ar'], publisher: { '@id': studioId } },
  { '@type': 'WebPage', '@id': canonical.href + '#page', url: canonical.href,
    name: pageTitle, description: desc, inLanguage: locale, isPartOf: { '@id': websiteId },
    ...(product ? { mainEntity: { '@id': canonical.href + '#app' } } : {}) },
  ...(product ? [{ '@type': 'SoftwareApplication', '@id': canonical.href + '#app',
    name: product.name, url: canonical.href, description: desc,
    applicationCategory: productDiscovery[product.slug].category,
    publisher: { '@id': studioId }, image: new URL(product.icon.src, site).href,
    ...(product.storeUrl ? { operatingSystem: 'Android', installUrl: product.storeUrl } : {}) }] : []),
  ...structuredData,
];
// Extensions enrich the same page entity rather than defining conflicting copies.
const entities = new Map<string, Record<string, unknown>>();
for (const node of graph) {
  const id = String(node['@id'] ?? `node-${entities.size}`);
  entities.set(id, { ...entities.get(id), ...node });
}
---

<!doctype html>
<html lang={locale} dir={dir[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Applies the stored theme before first paint. Anything later flashes. */}
    <script is:inline>
      try {
        const t = localStorage.getItem("sater-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {
        /* private mode — fall back to the system preference */
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    {cleanPath === '/404' && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [...entities.values()] }).replaceAll('<', '\\u003c')} />

    {
      localized && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(localizePath(path, "en"), site).href} />
          <link rel="alternate" hreflang="ar" href={new URL(localizePath(path, "ar"), site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, "en"), site).href} />
        </>
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SATER" />
    <meta property="og:locale" content={locale === "ar" ? "ar_JO" : "en_US"} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f3f0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17171a" />

    <link
      rel="preload"
      href={locale === 'ar' ? '/fonts/ar-700.woff2' : '/fonts/sans-700.woff2'}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={locale === 'ar' ? '/fonts/ar-400.woff2' : '/fonts/sans-400.woff2'}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">{t("nav.skip" as UIKey)}</a>
    <Nav locale={locale} path={path} localized={localized} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} path={path} localized={localized} />
    <ScribeMotion />
  </body>
</html>
