---
import { Image } from 'astro:assets';
import { newsCopy, newsDate, type NewsArticle } from '~/data/news';
import { localizePath } from '~/i18n/ui';
import { games, tools, type Locale } from '~/data/products';
interface Props { articles: NewsArticle[]; locale: Locale }
const { articles, locale } = Astro.props;
const copy = newsCopy[locale];
---
<div class="news-cards">
  {articles.map(article => <article class:list={['news-card', article.kind, { 'contain-art': article.illustrationFit === 'contain' }]}>
    <a class="story" href={localizePath(`/news/${article.slug}`, locale)}>
      <div class="art" aria-hidden="true">
        <span class="edition">{article.kind.toUpperCase()}</span>
        <span class="art-title">{article.coverTitle}<small>{[...games, ...tools].find(p => p.slug === article.product)?.name ?? 'SATER'}</small></span>
        <Image src={article.illustration} alt="" width={290} loading="lazy" />
      </div>
      <div class="copy">
        <p class="meta"><span>{copy[article.kind]}</span><time datetime={article.date}>{newsDate(article.date, locale)}</time></p>
        <h3>{article.title[locale]}</h3>
        <p class="summary">{article.summary[locale]}</p>
        <span class="read">{copy.read} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></span>
      </div>
    </a>
  </article>)}
</div>
{articles.length === 0 && <p class="empty">{copy.empty} <a href={localizePath('/news', locale)}>{copy.all}</a></p>}
<style>
  .news-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--s-4); }
  .news-card { min-width:0; border:1px solid var(--edge); border-radius:var(--radius-card); overflow:hidden; }
  .story { display:block; height:100%; color:inherit; text-decoration:none; }
  .art { position:relative; overflow:hidden; aspect-ratio:2/1; background:#142b43; color:#fff1db; isolation:isolate; direction:ltr; }
  .guide .art { background:#242035; }
  .edition { position:absolute; top:8%; left:7%; font:0.75rem var(--mono); letter-spacing:.1em; }
  .art-title { position:absolute; left:7%; top:28%; font-size:clamp(2.5rem,7vw,5rem); font-weight:800; line-height:1.2; color:#ffad59; }
  .guide .art-title { color:#d3c1ff; }
  .art-title small { display:block; font:0.75rem var(--mono); color:#fff1db; letter-spacing:.03em; margin-top:.7rem; }
  .art img { position:absolute; height:145%; width:auto; right:2%; top:3%; max-width:45%; object-fit:contain; object-position:top; z-index:-1; }
  .contain-art .art img { height:85%; top:10%; object-position:center; }
  .copy { padding:var(--s-3); display:grid; gap:var(--s-2); }
  .meta { display:flex; flex-wrap:wrap; gap:.5rem 1rem; justify-content:space-between; font-size:.875rem; color:var(--fg-dim); }
  h3 { font-size:clamp(1.3rem,2.2vw,1.75rem); line-height:1.5; }
  .summary,.empty { color:var(--fg-dim); line-height:1.8; }
  .read { font-size:.95rem; font-weight:700; }
  .story:hover h3 { text-decoration:underline; text-underline-offset:.2em; }
  .story:focus-visible { outline:3px solid var(--fg); outline-offset:-4px; }
  @media(max-width:650px) { .news-cards { grid-template-columns:1fr; } }
</style>
