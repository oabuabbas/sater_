---
import Logo from "~/components/Logo.astro";
import { studioLinks } from "~/data/products";
import { useTranslations, localizePath, localeName, type UIKey } from "~/i18n/ui";
import type { Locale } from "~/data/products";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const other: Locale = locale === "en" ? "ar" : "en";
const year = new Date().getFullYear();
---

<footer class="foot band-raised">
  <div class="inner">
    <Logo variant="mark" height={40} />
    <p class="line label">{t("footer.rights" as UIKey)}</p>
    <p class="line label tabular">{year}</p>
    <nav class="social label" aria-label={t("studio.links.head" as UIKey)}>
      <a href={studioLinks.play} target="_blank" rel="noopener noreferrer">Play ↗</a>
      <a href={studioLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
      <a href={studioLinks.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
    </nav>
    <a class="line label lang" href={localizePath(path, other)} lang={other} hreflang={other}>
      {localeName[other]}
    </a>
  </div>
</footer>

<style>
  .foot {
    background: var(--bg);
    color: var(--fg);
    border-block-start: var(--hair) solid var(--edge);
  }

  .inner {
    width: var(--col);
    margin-inline: auto;
    padding-block: var(--s-8);
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .line {
    margin: 0;
    color: var(--fg-dim);
  }

  .lang {
    transition: color var(--dur) var(--ease);
  }

  .lang:hover {
    color: var(--fg);
  }

  .social {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-inline-start: auto;
    color: var(--fg-dim);
  }

  .social a {
    transition: color var(--dur) var(--ease);
  }

  .social a:hover {
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .social {
      order: 3;
      inline-size: 100%;
      margin-inline-start: 0;
      padding-block-start: var(--s-2);
      border-block-start: var(--hair) solid var(--edge);
      flex-wrap: wrap;
    }

    .lang {
      margin-inline-start: auto;
    }
  }
</style>
