---
/**
 * A band: the only element allowed to repaint the palette. Children read
 * --bg / --fg / --fg-dim / --edge / --accent and never name a colour.
 */

interface Props {
  tone?: "base" | "raised";
  /** Remove the inner column so a child can run full-bleed. */
  flush?: boolean;
  as?: "section" | "div" | "header" | "footer";
  class?: string;
  id?: string;
  labelledby?: string;
}

const {
  tone = "base",
  flush = false,
  as: Tag = "section",
  class: className,
  id,
  labelledby,
} = Astro.props;
---

<Tag id={id} aria-labelledby={labelledby} class:list={["band", `band-${tone}`, className]} data-scribe>
  <span class="cut-rule" aria-hidden="true"></span>
  <div class:list={["inner", { flush }]}>
    <slot />
  </div>
</Tag>

<style>
  .band {
    position: relative;
    background: var(--bg);
    color: var(--fg);
  }

  /* When a band enters the viewport, its rule draws inward and stops around
     the same central cut carried by the V2 mark. */
  .cut-rule {
    position: absolute;
    inset: 0 0 auto;
    block-size: 1px;
    pointer-events: none;
    overflow: hidden;
  }

  .cut-rule::before,
  .cut-rule::after {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inline-size: calc(50% - var(--s-2));
    block-size: 1px;
    background: var(--fg);
    opacity: 0.28;
    transform: scaleX(0);
    transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cut-rule::before {
    inset-inline-start: 0;
    transform-origin: left;
  }

  .cut-rule::after {
    inset-inline-end: 0;
    transform-origin: right;
    transition-delay: 80ms;
  }

  .band.is-inscribed .cut-rule::before,
  .band.is-inscribed .cut-rule::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .cut-rule::before,
    .cut-rule::after {
      transform: scaleX(1);
      transition: none;
    }
  }

  .inner {
    width: var(--col);
    margin-inline: auto;
    padding-block: var(--band);
  }

  .inner.flush {
    width: 100%;
    padding-block: 0;
  }
</style>
