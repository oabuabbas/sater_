---
/**
 * One shipped tool. The frame is identical for every product and only the
 * artwork inside differs — the studio owns two icon families (flat house marks
 * and glossy store icons) and the site reconciles them by framing, not by
 * restyling. The card sets --accent from the product's own art, which is where
 * all of this page's colour comes from.
 */

import { Image } from "astro:assets";
import StatusBadge from "~/components/StatusBadge.astro";
import { useTranslations, type UIKey } from "~/i18n/ui";
import type { Locale, Product } from "~/data/products";

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = useTranslations(locale);
const statusKey = `status.${product.status}` as UIKey;

const Tag = product.legacyPath ? "a" : "article";
---

<Tag
  class="card"
  href={product.legacyPath}
  style={`--accent:${product.accent};--ground:${product.ground}`}
>
  <span class:list={["art", product.art]}>
    <Image
      src={product.feature ?? product.icon}
      alt={`${product.name} artwork`}
      width={1024}
      height={500}
      loading="eager"
    />
  </span>

  <span class="meta">
    <span class="identity">
      <span class:list={["icon", product.art]} aria-hidden="true">
        <Image src={product.icon} alt="" width={128} height={128} />
      </span>
      <span class="head">
        <h3 class="name">{product.name}</h3>
        {product.root && <span class="root" lang="ar"><bdi>{product.root}</bdi></span>}
      </span>
    </span>
    <span class="tagline">{product.tagline[locale]}</span>
    {product.gloss && <span class="gloss">{product.gloss[locale]}</span>}
    <StatusBadge status={product.status} label={t(statusKey)} />
  </span>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-2);
    background: var(--surface-2);
    border-radius: var(--radius-card);
    border: var(--hair) solid var(--edge);
    color: var(--fg);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  a.card:hover,
  a.card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--accent) 13%, transparent);
  }

  /* The artwork sits on the ground it was drawn for, so a glossy store icon
     and a flat house mark both read correctly in the same row. */
  .art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1024 / 500;
    background: var(--ground);
    border-radius: var(--radius-art);
    overflow: hidden;
    /* A neutral translucent ring rather than --edge: the grounds range from
       white (ZILL) to near-black (TAM), and a themed border either vanishes
       into the light ones or glows on the dark ones. */
    box-shadow: inset 0 0 0 var(--hair) rgb(128 128 128 / 0.28);
  }

  /* A finished app icon owns its own background and fills the frame. Inset it
     and its anti-aliased edge sits on a near-identical ground, which reads as
     a stray hairline border. */
  .art.full :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 520ms var(--ease);
  }

  a.card:hover .art :global(img),
  a.card:focus-visible .art :global(img) {
    transform: scale(1.025);
  }

  .art.inset :global(img) {
    width: 66%;
    height: 66%;
    object-fit: contain;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    flex: 1;
    padding: var(--s-1);
  }

  .identity {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-start: calc(var(--s-3) * -1);
    position: relative;
    z-index: 1;
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    flex: none;
    overflow: hidden;
    border-radius: calc(var(--radius-card) - 2px);
    background: var(--ground);
    border: 3px solid var(--surface-2);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .icon.full :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .icon.inset :global(img) {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  .name {
    font-size: var(--step-2);
    line-height: var(--lead-tight);
  }

  .root {
    font-family: var(--arabic);
    font-weight: var(--w-bold);
    font-size: var(--step-2);
    color: var(--accent);
    line-height: var(--lead-tight);
  }

  .tagline {
    color: var(--fg);
  }

  .gloss {
    color: var(--fg-dim);
    font-size: 0.9375rem;
  }

  .meta :global(.status-badge) {
    margin-block-start: var(--s-2);
  }
</style>
