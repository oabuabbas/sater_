---
import { getImage } from "astro:assets";
import { catalog } from "~/data/catalog";
import { useTranslations, type UIKey } from "~/i18n/ui";
import type { Locale } from "~/data/products";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const labels = {
  start: t("runner.start" as UIKey),
  restart: t("runner.restart" as UIKey),
  jump: t("runner.jump" as UIKey),
  ready: t("runner.ready" as UIKey),
  over: t("runner.over" as UIKey),
};
const roster = await Promise.all(catalog.map(async product => ({
  slug: product.slug,
  name: product.localizedName?.[locale] ?? (locale === "ar" && product.root ? product.root : product.name),
  icon: (await getImage({src:product.icon, width:88, height:88, format:"webp"})).src,
  accent: product.accent,
})));
---

<section
  class="runner"
  data-sater-runner
  data-labels={JSON.stringify(labels)}
  id="line-game"
  aria-labelledby="runner-head"
  data-roster={JSON.stringify(roster)}
  dir={locale === "ar" ? "rtl" : "ltr"}
>
  <header class="intro">
    <h2 id="runner-head">{t("runner.head")}</h2>
    <p>{locale === "ar" ? "اقفز بحرف «س» فوق منتجات الاستوديو." : "Jump over the studio’s products with the letter س."}</p>
    <ul class="cast" aria-label={locale === "ar" ? "منتجات اللعبة" : "Products in the game"}>
      {roster.map(product => <li><img src={product.icon} width="28" height="28" alt={product.name} title={product.name}/></li>)}
    </ul>
    <button class="start" type="button" data-start>{labels.start}</button>
    <span role="status" data-card hidden><span data-state></span></span>
  </header>
  <div class="machine">
    <div class="hud">
      <span>{t("runner.score")} <b data-score>000</b></span>
      <span>{t("runner.best")} <b data-best>000</b></span>
    </div>
    <button class="stage" type="button" data-stage aria-label={labels.start}>
      <canvas data-canvas aria-hidden="true"></canvas>
    </button>
    <p class="hint">{labels.jump}</p>
  </div>
</section>

<script>
  type Obstacle = { x: number; size: number; image: HTMLImageElement; accent: string };
  type Trail = { x: number; y: number; life: number };

  document.querySelectorAll<HTMLElement>("[data-sater-runner]").forEach((root) => {
    const stage = root.querySelector<HTMLButtonElement>("[data-stage]");
    const start = root.querySelector<HTMLButtonElement>("[data-start]");
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]");
    const scoreNode = root.querySelector<HTMLElement>("[data-score]");
    const bestNode = root.querySelector<HTMLElement>("[data-best]");
    const card = root.querySelector<HTMLElement>("[data-card]");
    const stateNode = root.querySelector<HTMLElement>("[data-state]");
    if (!stage || !start || !canvas || !scoreNode || !bestNode || !card || !stateNode) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const labels = JSON.parse(root.dataset.labels ?? "{}") as Record<string, string>;
    const roster = JSON.parse(root.dataset.roster ?? "[]") as {icon:string; accent:string; name:string}[];
    const images = roster.map(({icon:src}) => {
      const image = new Image();
      image.src = src;
      return image;
    });

    // Keep the bag across retries so even short rounds reveal different products.
    let remaining: number[] = [];
    let previous = -1;
    function nextProduct() {
      if (!remaining.length) {
        remaining = roster.map((_, index) => index);
        for (let i = remaining.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [remaining[i], remaining[j]] = [remaining[j], remaining[i]];
        }
        const last = remaining.length - 1;
        if (last > 0 && remaining[last] === previous) {
          [remaining[last], remaining[0]] = [remaining[0], remaining[last]];
        }
      }
      previous = remaining.pop()!;
      return previous;
    }
    let width = 0;
    let height = 0;
    let dpr = 1;
    let baseline = 0;
    let running = false;
    let ended = false;
    let frameId = 0;
    let last = 0;
    let elapsed = 0;
    let nextObstacle = 0.9;
    let playerY = 0;
    let velocity = 0;
    let obstacles: Obstacle[] = [];
    let trail: Trail[] = [];
    let best = 0;
    try { best = Number(localStorage.getItem("sater-line-best")) || 0; } catch { /* Storage is optional. */ }
    bestNode.textContent = String(best).padStart(3, "0");

    const css = () => getComputedStyle(root);
    const color = (name: string, fallback: string) => css().getPropertyValue(name).trim() || fallback;

    function resize() {
      const rect = stage.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      baseline = Math.round(height * 0.74);
      draw();
    }

    function roundedImage(image: HTMLImageElement, x: number, y: number, size: number) {
      const radius = Math.max(7, size * 0.2);
      ctx.save();
      ctx.beginPath();
      ctx.roundRect(x, y, size, size, radius);
      ctx.clip();
      if (image.complete && image.naturalWidth) ctx.drawImage(image, x, y, size, size);
      else {
        ctx.fillStyle = color("--surface-2", "#26262c");
        ctx.fillRect(x, y, size, size);
      }
      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);
      const fg = color("--run-ink", "#f2f1ef");
      const dim = color("--run-muted", "#a8a5a1");
      const edge = color("--run-grid", "#34343c");

      ctx.strokeStyle = edge;
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 12]);
      for (let x = 18; x < width; x += 54) {
        ctx.beginPath();
        ctx.moveTo(x, 18);
        ctx.lineTo(x, height - 18);
        ctx.stroke();
      }
      ctx.setLineDash([]);

      ctx.strokeStyle = fg;
      ctx.globalAlpha = 0.78;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, baseline + 1);
      ctx.lineTo(width, baseline + 1);
      ctx.stroke();
      ctx.globalAlpha = 1;

      for (const dot of trail) {
        ctx.fillStyle = dim;
        ctx.globalAlpha = Math.max(0, dot.life);
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, 2.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      const playerX = Math.max(58, width * 0.14);
      ctx.fillStyle = fg;
      ctx.font = `700 ${Math.min(66, Math.max(48, width * 0.065))}px "Plex Arabic", sans-serif`;
      ctx.textAlign = "center";
      ctx.textBaseline = "alphabetic";
      ctx.fillText("س", playerX, baseline - playerY + 2);

      if (!running && !ended) {
        const size = Math.min(34, width * .065);
        images.forEach((image, index) => {
          const fraction = .28 + .63 * index / Math.max(1, images.length - 1);
          roundedImage(image, width * fraction, baseline - size, size);
        });
      }
      for (const item of obstacles) {
        const y = baseline - item.size;
        ctx.save();
        ctx.shadowColor = item.accent;
        ctx.shadowBlur = 0;
        roundedImage(item.image, item.x, y, item.size);
        ctx.restore();
        ctx.fillStyle = item.accent;
        ctx.fillRect(item.x + 5, baseline + 7, item.size - 10, 2);
      }
    }

    function reset() {
      elapsed = 0;
      nextObstacle = 0.85;
      playerY = 0;
      velocity = 0;
      obstacles = [];
      trail = [];
      scoreNode.textContent = "000";
      ended = false;
    }

    function begin() {
      cancelAnimationFrame(frameId);
      reset();
      running = true;
      card.hidden = true;
      start.textContent = labels.restart;
      stage.setAttribute("aria-label", labels.jump);
      stage.focus({ preventScroll: true });
      last = performance.now();
      frameId = requestAnimationFrame(frame);
    }

    function jump() {
      if (!running) {
        begin();
        return;
      }
      if (playerY < 3) {
        velocity = Math.max(520, height * 1.72);
        trail.push({ x: Math.max(58, width * 0.14), y: baseline - 10, life: 1 });
      }
    }

    function finish() {
      running = false;
      ended = true;
      const score = Math.floor(elapsed * 10);
      best = Math.max(best, score);
      try { localStorage.setItem("sater-line-best", String(best)); } catch { /* Keep the session score. */ }
      bestNode.textContent = String(best).padStart(3, "0");
      stateNode.textContent = labels.over;
      card.hidden = false;
      start.textContent = labels.restart;
      stage.setAttribute("aria-label", labels.restart);
    }

    function frame(now: number) {
      if (!running) return;
      const dt = Math.min((now - last) / 1000, 0.034);
      last = now;
      elapsed += dt;
      const speed = Math.min(640, 250 + elapsed * 9);
      const gravity = Math.max(1450, height * 5.2);

      velocity -= gravity * dt;
      playerY = Math.max(0, playerY + velocity * dt);
      if (playerY === 0 && velocity < 0) velocity = 0;

      nextObstacle -= dt;
      if (nextObstacle <= 0 && images.length) {
        const index = nextProduct();
        const size = Math.min(50, Math.max(36, width * 0.055));
        obstacles.push({ x: width + size, size, image: images[index], accent: roster[index].accent });
        nextObstacle = Math.max(0.72, 1.42 - elapsed * 0.012) + Math.random() * 0.55;
      }

      obstacles.forEach((item) => (item.x -= speed * dt));
      obstacles = obstacles.filter((item) => item.x + item.size > -10);
      trail.forEach((dot) => {
        dot.x -= speed * dt * 0.42;
        dot.life -= dt * 1.7;
      });
      trail = trail.filter((dot) => dot.life > 0);
      if (playerY > 7 && Math.random() < 0.28) {
        trail.push({ x: Math.max(58, width * 0.14) - 15, y: baseline - playerY - 18, life: 0.75 });
      }

      const px = Math.max(58, width * 0.14);
      const player = { left: px - 19, right: px + 18, top: baseline - playerY - 47, bottom: baseline - playerY - 5 };
      const hit = obstacles.some((item) => {
        const top = baseline - item.size + 5;
        return player.right > item.x + 5 && player.left < item.x + item.size - 5 && player.bottom > top && player.top < baseline;
      });
      if (hit) {
        finish();
        draw();
        return;
      }

      scoreNode.textContent = String(Math.floor(elapsed * 10)).padStart(3, "0");
      draw();
      frameId = requestAnimationFrame(frame);
    }

    stage.addEventListener("click", jump);
    start.addEventListener("click", begin);
    stage.addEventListener("keydown", (event) => {
      if (event.key === " " || event.key === "ArrowUp") {
        event.preventDefault();
        jump();
      }
    });

    images.forEach(image => image.addEventListener("load", draw));
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    new ResizeObserver(resize).observe(stage);
    document.fonts.ready.then(resize);
    resize();
  });
</script>

<style>
  .runner { --run-ink:#fff4dc; --run-muted:#d2cebe; --run-grid:#45554d; display:grid; grid-template-columns:minmax(15rem,.8fr) minmax(0,1.7fr); gap:clamp(1.5rem,4vw,4rem); align-items:center; background:#172921; color:var(--run-ink); border-radius:7px; padding:clamp(1.4rem,3.5vw,3.5rem); }
  .intro h2 { font-size:clamp(1.75rem,3vw,2.8rem); font-weight:600; }
  .intro p,.hint { color:var(--run-muted); }
  .cast { display:flex; align-items:center; gap:.35rem; flex-wrap:wrap; margin-block:.85rem; }
  .cast img { border-radius:6px; border:1px solid #ffffff30; }
  .start { min-height:42px; padding:.35rem 1.3rem; font:inherit; font-weight:600; background:#ede5ca; color:#15241d; border:0; border-radius:4px; cursor:pointer; }
  .intro [role=status] { display:block; margin-block-start:.45rem; color:var(--run-muted); }
  .intro [hidden] {display:none;}
  .machine { position:relative; min-width:0; }
  .hud { display:flex; gap:1.4rem; font-size:.85rem; color:var(--run-muted); }
  .hud b { font-family:var(--mono); color:var(--run-ink); }
  .stage { display:block; background:transparent; height:185px; width:100%; border:0; padding:0; cursor:pointer; touch-action:manipulation; }
  canvas { display:block; width:100%; height:100%; }
  .hint { font-size:.85rem; }
  .runner :focus-visible { outline-color:#f3d391; }
  @media(max-width:740px) {
    .runner { grid-template-columns:1fr; gap:1.3rem; }
    .stage { height:185px; }
  }
</style>
