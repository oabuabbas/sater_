---
import Band from "~/components/Band.astro";
import PageHead from "~/components/PageHead.astro";
import Logo from "~/components/Logo.astro";
import { tools, games, horizon, studioLinks, type Locale } from "~/data/products";
import { useTranslations, type UIKey } from "~/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const counts = [
  ["hero.fact.shipped", tools.length],
  ["hero.fact.build", games.length],
  ["hero.fact.research", horizon.length],
] as const;
---

<PageHead title={t("studio.title" as UIKey)} lede={t("studio.lede" as UIKey)} />

<Band tone="raised">
  <div class="cols">
    <div class="prose">
      <p>{t("studio.body.1" as UIKey)}</p>
      <p>{t("studio.body.2" as UIKey)}</p>
    </div>

    <dl class="facts">
      {
        counts.map(([key, n]) => (
          <div>
            <dt class="n tabular">{String(n).padStart(2, "0")}</dt>
            <dd class="label">{t(key as UIKey)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Band>

<Band tone="raised" labelledby="studio-links-head">
  <div class="presence">
    <header>
      <h2 id="studio-links-head">{t("studio.links.head" as UIKey)}</h2>
      <p>{t("studio.links.note" as UIKey)}</p>
    </header>
    <nav class="channels" aria-label={t("studio.links.head" as UIKey)}>
      <a href={studioLinks.play} target="_blank" rel="noopener noreferrer">
        <span class="node" aria-hidden="true"></span>
        <span>{t("studio.links.play" as UIKey)} ↗</span>
      </a>
      <a href={studioLinks.youtube} target="_blank" rel="noopener noreferrer">
        <span class="node" aria-hidden="true"></span>
        <span>{t("studio.links.youtube" as UIKey)} ↗</span>
      </a>
      <a href={studioLinks.facebook} target="_blank" rel="noopener noreferrer">
        <span class="node" aria-hidden="true"></span>
        <span>{t("studio.links.facebook" as UIKey)} ↗</span>
      </a>
    </nav>
  </div>
</Band>

<Band tone="base">
  <div class="split">
    <div class="block">
      <h2 class="label">{t("studio.founder.role" as UIKey)}</h2>
      <p class="name">{t("studio.founder.name" as UIKey)}</p>
      <p class="where">{t("site.descriptor" as UIKey)}</p>
    </div>

    <div class="block">
      <h2 class="label">{t("studio.doctrine.head" as UIKey)}</h2>
      <p class="doctrine-body">{t("studio.doctrine.body" as UIKey)}</p>
      <span class="mark"><Logo variant="mark" height={44} /></span>
    </div>
  </div>
</Band>

<style>
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-8);
    align-items: start;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    font-size: var(--step-1);
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;
    padding-inline-start: var(--s-4);
    border-inline-start: var(--hair) solid var(--edge);
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .facts .n {
    font-size: var(--step-4);
    font-weight: var(--w-bold);
    line-height: var(--lead-tight);
    letter-spacing: var(--track-display);
  }

  .facts dd {
    margin: 0;
    color: var(--fg-dim);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-8);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    align-items: flex-start;
  }

  .block h2 {
    color: var(--fg-dim);
    font-weight: var(--w-regular);
  }

  .name {
    font-size: var(--step-3);
    font-weight: var(--w-bold);
    letter-spacing: var(--track-display);
  }

  .where {
    color: var(--fg-dim);
  }

  .doctrine-body {
    color: var(--fg-dim);
  }

  .mark {
    margin-block-start: var(--s-2);
    color: var(--fg-dim);
  }

  .presence {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 1.4fr);
    gap: var(--s-8);
    align-items: end;
  }

  .presence header {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .presence h2 {
    font-size: var(--step-3);
  }

  .presence p {
    color: var(--fg-dim);
  }

  .channels {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .channels::before {
    content: "";
    position: absolute;
    inset-inline: 7px;
    inset-block-start: 7px;
    block-size: 2px;
    background: var(--fg);
  }

  .channels a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-1);
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    transition: color var(--dur) var(--ease);
  }

  .channels a:hover,
  .channels a:focus-visible {
    color: var(--fg);
  }

  .node {
    inline-size: 16px;
    block-size: 16px;
    border: 2px solid var(--fg);
    border-radius: 50%;
    background: var(--bg);
    z-index: 1;
    transition: background var(--dur) var(--ease);
  }

  .channels a:hover .node,
  .channels a:focus-visible .node {
    background: var(--fg);
  }

  @media (max-width: 820px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }

    .facts {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--s-6);
      padding-inline-start: 0;
      padding-block-start: var(--s-3);
      border-inline-start: 0;
      border-block-start: var(--hair) solid var(--edge);
    }

    .presence {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
  }
</style>
