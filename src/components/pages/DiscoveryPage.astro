---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import PageHead from '~/components/PageHead.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import NewsSection from '~/components/NewsSection.astro';
import { tools, games, type Locale } from '~/data/products';
import { discovery, productDiscovery } from '~/data/discovery';
import { localizePath, useTranslations, type UIKey } from '~/i18n/ui';
interface Props { locale: Locale; kind: 'apps' | 'games' }
const { locale, kind } = Astro.props;
const copy = discovery[kind];
const products = kind === 'apps' ? tools : games;
const ar = locale === 'ar';
const t = useTranslations(locale);
const path = `/sater-${kind}`;
const site = Astro.site!;
const collection = {
  '@type': 'CollectionPage', '@id': new URL(localizePath(path, locale), site).href + '#page',
  name: copy.title[locale], description: copy.description[locale],
  mainEntity: { '@type': 'ItemList', itemListElement: products.map((p, index) => ({
    '@type': 'ListItem', position: index + 1, name: p.name,
    url: new URL(localizePath(p.legacyPath!, locale), site).href,
  })) },
};
const breadcrumb = {
  '@type': 'BreadcrumbList', '@id': new URL(localizePath(path,locale),site).href + '#breadcrumb',
  itemListElement: [
    { '@type':'ListItem',position:1,name:ar?'سطر':'SATER',item:new URL(localizePath('/',locale),site).href },
    { '@type':'ListItem',position:2,name:copy.title[locale],item:new URL(localizePath(path,locale),site).href },
  ],
};
---
<Base locale={locale} title={copy.title[locale]} path={path} description={copy.description[locale]} structuredData={[collection,breadcrumb]}>
  <PageHead title={copy.title[locale]} lede={copy.subtitle[locale]} />
  <Band tone="raised" labelledby="choose-head">
    <nav class="breadcrumbs" aria-label={ar?'مسار التصفح':'Breadcrumb'}><a href={localizePath('/',locale)}>{ar?'سطر':'SATER'}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.title[locale]}</span></nav>
    <header class="intro"><h2 id="choose-head">{copy.heading[locale]}</h2><p>{copy.intro[locale]}</p></header>
    <div class:list={['products', { games: kind === 'games' }]}>
      {products.map(product => (
        <article class="product" style={`--accent:${product.accent}`}>
          <a class="art" href={localizePath(product.legacyPath!, locale)} aria-label={product.name}>
            <Image src={product.feature ?? product.icon} alt={ar ? `صورة ${product.name}` : `${product.name} artwork`} width={1024} height={500} />
          </a>
          <div class="copy">
            <StatusBadge status={product.status} label={t(`status.${product.status}` as UIKey)} />
            <h3><a href={localizePath(product.legacyPath!, locale)}>{product.name}</a></h3>
            <p class="purpose">{productDiscovery[product.slug].purpose[locale]}</p>
            <p>{productDiscovery[product.slug].body[locale]}</p>
            <nav aria-label={`${product.name} — ${ar ? 'روابط' : 'links'}`}>
              <a href={localizePath(product.legacyPath!, locale)}>{ar ? 'اكتشف المنتج' : 'Explore product'}</a>
              {product.storeUrl && <a href={product.storeUrl} target="_blank" rel="noopener noreferrer">Google Play ↗</a>}
            </nav>
          </div>
        </article>
      ))}
    </div>
  </Band>
  <Band tone="base" labelledby="answers-head">
    <h2 id="answers-head">{ar ? 'قبل أن تبدأ' : 'Before you start'}</h2>
    <div class="answers">{copy.questions.map(q => <details><summary>{q.title[locale]}</summary><p>{q.body[locale]}</p></details>)}</div>
    <nav class="more" aria-label={ar ? 'اكتشف المزيد' : 'Discover more'}>
      <a href={localizePath(kind === 'apps' ? '/tools' : '/play', locale)}>{copy.catalog[locale]}</a>
      <a href={localizePath(kind === 'apps' ? '/sater-games' : '/sater-apps', locale)}>{discovery[kind === 'apps' ? 'games' : 'apps'].title[locale]}</a>
    </nav>
  </Band>
  <NewsSection locale={locale} product={kind} />
</Base>
<style>
  .intro {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--s-6);margin-bottom:var(--s-6)}
  .breadcrumbs {margin-bottom:var(--s-4);color:var(--fg-dim);font-size:.9rem}
  h2 {font-size:var(--step-head);line-height:var(--lead-head)}
  p {color:var(--fg-dim)}
  .products {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s-3)}
  .products.games {grid-template-columns:repeat(2,minmax(0,1fr))}
  .product {border:var(--hair) solid var(--edge);border-radius:var(--radius-card);overflow:hidden;background:var(--surface-2);display:flex;flex-direction:column}
  .art {display:block;aspect-ratio:1024/500;overflow:hidden;background:#080c10}
  .art :global(img) {width:100%;height:100%;object-fit:cover;transition:transform 400ms var(--ease)}
  .art:hover :global(img) {transform:scale(1.025)}
  .copy {padding:var(--s-3);display:flex;flex-direction:column;align-items:flex-start;gap:var(--s-2);flex:1}
  h3 {font-size:var(--step-2);line-height:var(--lead-tight)}
  .copy h3 {font-size:var(--step-3)}
  .purpose {color:var(--fg);font-size:var(--step-1)}
  .copy nav {margin-top:auto;padding-top:var(--s-3);border-top:var(--hair) solid var(--edge);width:100%}
  nav {display:flex;flex-wrap:wrap;gap:var(--s-2)}
  nav a {text-decoration:underline;text-underline-offset:.25em}
  nav a:hover {color:var(--accent,var(--fg))}
  .answers {margin-block:var(--s-4);max-width:70ch}
  .answers details {border-bottom:var(--hair) solid var(--edge)}
  .answers summary {padding-block:var(--s-3);cursor:pointer;font-weight:var(--w-bold);line-height:var(--lead-body)}
  .answers details p {padding-block-end:var(--s-3);max-width:64ch}
  .more {border-top:var(--hair) solid var(--edge);padding-top:var(--s-4)}
  @media(max-width:850px){.products,.products.games,.intro,.answers{grid-template-columns:minmax(0,1fr)}.intro,.answers{gap:var(--s-3)}}
  @media(prefers-reduced-motion:reduce){.art :global(img){transition:none}}
</style>
