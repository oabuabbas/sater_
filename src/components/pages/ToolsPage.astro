---
import { Image } from "astro:assets";
import Band from "~/components/Band.astro";
import PageHead from "~/components/PageHead.astro";
import ProductLine, { type ProductLineItem } from "~/components/ProductLine.astro";
import { tools, type Locale } from "~/data/products";
import { useTranslations, type UIKey } from "~/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Product and legal pages are English-only routes carried over from the old site. */
const legacy = (product: (typeof tools)[number], page: "" | "privacy" | "terms") =>
  product.legacyPath ? `${product.legacyPath}${page}` : undefined;

const productLine = (product: (typeof tools)[number]): ProductLineItem[] => [
  { label: t("tools.store" as UIKey), href: product.storeUrl, external: true },
  { label: t("tools.page" as UIKey), href: legacy(product, "") },
  { label: t("tools.privacy" as UIKey), href: legacy(product, "privacy") },
  ...(product.slug === "zill"
    ? []
    : [{ label: t("tools.terms" as UIKey), href: legacy(product, "terms") }]),
];
---

<PageHead title={t("tools.title" as UIKey)} lede={t("tools.lede" as UIKey)} />

<Band tone="raised">
  <ul class="list">
    {
      tools.map((product) => (
        <li class="row" style={`--accent:${product.accent};--ground:${product.ground}`}>
          <span class:list={["art", product.art]}>
            <Image src={product.icon} alt={`${product.name} icon`} width={440} height={440} />
          </span>

          <div class="body">
            <div class="head">
              <h2>{product.name}</h2>
              {product.root && (
                <span class="root" lang="ar">
                  <bdi>{product.root}</bdi>
                </span>
              )}
            </div>

            <p class="tagline">{product.tagline[locale]}</p>
            {product.gloss && <p class="gloss">{product.gloss[locale]}</p>}
            {
              product.lineStory && (
                <p class="line-story">
                  <span class="label">{t("tools.firstline" as UIKey)}</span>
                  {product.lineStory[locale]}
                </p>
              )
            }

            <ProductLine
              label={`${product.name} — ${t("tools.line" as UIKey)}`}
              status={product.status}
              statusLabel={t(`status.${product.status}` as UIKey)}
              items={productLine(product)}
            />
          </div>
        </li>
      ))
    }
  </ul>
</Band>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  .row {
    display: grid;
    grid-template-columns: calc(var(--u) * 20) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    padding-block-end: var(--s-8);
    border-block-end: var(--hair) solid var(--edge);
  }

  .list li:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }

  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--ground);
    border-radius: var(--radius-art);
    overflow: hidden;
    box-shadow: inset 0 0 0 var(--hair) rgb(128 128 128 / 0.28);
  }

  .art.full :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art.inset :global(img) {
    width: 66%;
    height: 66%;
    object-fit: contain;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  h2 {
    font-size: var(--step-4);
    line-height: var(--lead-tight);
  }

  .root {
    font-family: var(--arabic);
    font-weight: var(--w-bold);
    font-size: var(--step-3);
    color: var(--accent);
  }

  .tagline {
    font-size: var(--step-lede);
  }

  .gloss {
    color: var(--fg-dim);
  }

  .line-story {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-2);
    margin-block-start: var(--s-1);
    padding-inline-start: var(--s-2);
    border-inline-start: 2px solid var(--accent);
    color: var(--fg-dim);
  }

  .line-story .label {
    color: var(--accent);
    white-space: nowrap;
  }

  .body :global(.product-line) {
    margin-block-start: var(--s-2);
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }

    .art {
      inline-size: calc(var(--u) * 16);
    }
  }
</style>
