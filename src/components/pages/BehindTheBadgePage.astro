---
import { Image } from "astro:assets";
import Band from "~/components/Band.astro";
import StatusBadge from "~/components/StatusBadge.astro";
import { behindTheBadgeDetail, games, type Locale } from "~/data/products";
import { localizePath, useTranslations, type UIKey } from "~/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const game = games.find((item) => item.slug === "behind-the-badge");
if (!game || !game.feature) throw new Error("Behind The Badge product data is incomplete");
const detail = behindTheBadgeDetail;
const t = useTranslations(locale);
---

<Band tone="base" flush class="btb-hero">
  <div class="hero-art">
    <Image
      src={game.feature}
      alt={locale === "ar"
        ? "Behind The Badge — إدارة كرة القدم من غرفة الإدارة"
        : "Behind The Badge — football management from the boardroom"}
      width={1600}
      height={781}
      loading="eager"
    />
    <div class="shade" aria-hidden="true"></div>
    <div class="hero-copy" style={`--accent:${game.accent}`}>
      <p class="back label"><a href={localizePath("/play", locale)}>&larr; {t("play.title" as UIKey)}</a></p>
      <p class="eyebrow label">{detail.eyebrow[locale]}</p>
      <h1>{game.name}</h1>
      <p class="statement">{detail.statement[locale]}</p>
      <div class="hero-actions">
        <StatusBadge status={game.status} label={t(`status.${game.status}` as UIKey)} />
        <a href={game.privacyPath}>{t("tools.privacy" as UIKey)}</a>
        <a href={game.termsPath}>{t("tools.terms" as UIKey)}</a>
      </div>
    </div>
  </div>
</Band>

<Band tone="raised" labelledby="roles-head">
  <div class="section-head">
    <p class="label">Behind the decision</p>
    <h2 id="roles-head">{detail.rolesHead[locale]}</h2>
    <p>{detail.rolesNote[locale]}</p>
  </div>

  <ol class="roles" style={`--accent:${game.accent}`}>
    {detail.roles.map((role) => (
      <li>
        <span class="role-code label">{role.code}</span>
        <h3>{role.title[locale]}</h3>
        <p>{role.body[locale]}</p>
      </li>
    ))}
  </ol>
</Band>

<Band tone="base" labelledby="world-head">
  <div class="world" style={`--accent:${game.accent}`}>
    <header class="world-head">
      <span class="crest" aria-hidden="true">
        <Image src={game.icon} alt="" width={160} height={160} />
      </span>
      <div>
        <h2 id="world-head">{detail.worldHead[locale]}</h2>
        <p>{detail.worldNote[locale]}</p>
      </div>
    </header>

    <dl class="facts">
      {detail.facts.map((fact) => (
        <div>
          <dt>
            <span class="label">{fact.code}</span>
            <strong>{fact.title[locale]}</strong>
          </dt>
          <dd>{fact.body[locale]}</dd>
        </div>
      ))}
    </dl>
  </div>
</Band>

<style>
  .btb-hero {
    --gold: #e8ce72;
  }

  .hero-art {
    position: relative;
    min-block-size: min(78vh, 780px);
    overflow: hidden;
    background: #050706;
  }

  .hero-art > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(2 4 4 / 0.88) 0%, rgb(2 4 4 / 0.52) 38%, transparent 68%),
      linear-gradient(0deg, rgb(2 4 4 / 0.82) 0%, transparent 48%);
  }

  :global([dir="rtl"]) .shade {
    transform: scaleX(-1);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-block-size: min(78vh, 780px);
    width: var(--col);
    margin-inline: auto;
    padding-block: var(--s-10);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--s-2);
    color: #f7f4ea;
  }

  .back {
    margin-block-end: auto;
    color: rgb(247 244 234 / 0.7);
  }

  .back a,
  .hero-actions a {
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .back a:hover,
  .hero-actions a:hover {
    color: var(--gold);
  }

  .eyebrow {
    color: var(--gold);
  }

  h1 {
    max-inline-size: 13ch;
    font-size: clamp(var(--step-4), 7vw, 5.5rem);
    line-height: 0.94;
    text-shadow: 0 4px 28px rgb(0 0 0 / 0.55);
  }

  .statement {
    max-inline-size: 34ch;
    font-size: var(--step-lede);
    color: rgb(247 244 234 / 0.82);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    margin-block-start: var(--s-2);
  }

  .hero-actions :global(.status-badge) {
    --bg: rgb(4 6 5 / 0.74);
    --fg: #f7f4ea;
    --fg-dim: rgb(247 244 234 / 0.76);
    --edge: rgb(232 206 114 / 0.42);
  }

  .hero-actions > a {
    padding: 7px 12px;
    border: 1px solid rgb(247 244 234 / 0.28);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    gap: var(--s-2) var(--s-8);
    align-items: end;
    margin-block-end: var(--s-8);
  }

  .section-head .label {
    grid-column: 1 / -1;
    color: var(--fg-dim);
  }

  .section-head h2,
  .world h2 {
    font-size: var(--step-head);
    line-height: var(--lead-head);
  }

  .section-head > p:last-child,
  .world-head p,
  .roles p,
  .facts dd {
    color: var(--fg-dim);
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: var(--hair) solid var(--edge);
  }

  .roles li {
    position: relative;
    display: flex;
    min-block-size: 280px;
    padding: var(--s-4);
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .roles li + li {
    border-inline-start: var(--hair) solid var(--edge);
  }

  .roles li::after {
    content: "";
    position: absolute;
    inset-inline: var(--s-4);
    inset-block-end: 0;
    block-size: 3px;
    background: var(--accent);
    transform: scaleX(0.16);
    transform-origin: inline-start;
    transition: transform 420ms var(--ease);
  }

  .roles li:hover::after {
    transform: scaleX(1);
  }

  .role-code {
    color: var(--accent);
  }

  .roles h3 {
    margin-block-start: auto;
    font-size: var(--step-3);
  }

  .world {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  .world-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-4);
    align-items: center;
    max-inline-size: 920px;
  }

  .world-head > div {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .crest {
    display: grid;
    place-items: center;
    inline-size: calc(var(--u) * 15);
    aspect-ratio: 1;
    overflow: hidden;
    border: var(--hair) solid color-mix(in srgb, var(--accent) 45%, var(--edge));
    border-radius: 50%;
    background: #010100;
    box-shadow: 0 0 60px color-mix(in srgb, var(--accent) 13%, transparent);
  }

  .crest :global(img) {
    width: 78%;
    height: 78%;
    object-fit: contain;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: 0;
  }

  .facts > div {
    display: flex;
    min-block-size: 230px;
    padding: var(--s-3);
    flex-direction: column;
    gap: var(--s-3);
    border: var(--hair) solid var(--edge);
    border-radius: var(--radius-card);
    background: var(--surface-2);
  }

  .facts dt {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .facts dt .label {
    color: var(--accent);
  }

  .facts dt strong {
    font-size: var(--step-2);
    line-height: var(--lead-tight);
  }

  .facts dd {
    margin: auto 0 0;
  }

  @media (max-width: 820px) {
    .hero-art,
    .hero-copy {
      min-block-size: 690px;
    }

    .hero-art > :global(img) {
      object-position: 58% center;
    }

    .shade,
    :global([dir="rtl"]) .shade {
      transform: none;
      background: linear-gradient(0deg, rgb(2 4 4 / 0.96) 0%, rgb(2 4 4 / 0.7) 48%, transparent 88%);
    }

    .section-head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .roles,
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .roles li {
      min-block-size: 220px;
    }

    .roles li + li {
      border-inline-start: 0;
      border-block-start: var(--hair) solid var(--edge);
    }
  }

  @media (max-width: 560px) {
    .hero-copy {
      padding-block: var(--s-6);
    }

    .world-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .crest {
      inline-size: calc(var(--u) * 11);
    }
  }
</style>
