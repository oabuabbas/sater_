---
import { Image } from "astro:assets";
import SaterRunner from "./SaterRunner.astro";
import harbor from "~/assets/home/aurelis-harbor.jpg";
import tamScreen from "~/assets/home/tam-screen.webp";
import chairmanScreen from "~/assets/home/chairman-screen.webp";
import { collections, findTheSpy } from "~/data/catalog";
import { newsFor, newsDate, newsCopy } from "~/data/news";
import { localizePath } from "~/i18n/ui";
import type { Locale } from "~/data/products";

interface Props { locale: Locale }
const { locale } = Astro.props;
const ar = locale === "ar";
const link = (path: string) => localizePath(path, locale);
const screens: Record<string,{ image: ImageMetadata; label: string }> = {
  tam: { image: tamScreen, label: ar ? "شاشة المهام" : "Task screen" },
  "studio-chairman": { image: chairmanScreen, label: ar ? "شاشة الإنتاج" : "Production screen" },
};
const stories = newsFor().slice(0,3);
---
<section class="hero" aria-labelledby="mast-title">
  <Image class="panorama" src={harbor} width={1800} quality={86} format="webp" loading="eager" fetchpriority="high" alt=""/>
  <div class="veil"></div>
  <div class="hero-inner">
    <div class="mast">
      <p class="location">{ar ? "استوديو مستقل · عمّان، الأردن" : "Independent studio · Amman, Jordan"}</p>
      <h1 id="mast-title">{ar ? "كل شيء يبدأ" : "Everything starts"}<br/><span>{ar ? "من سطر." : "with a line."}</span></h1>
      <p class="lede">{ar ? "نصمّم تطبيقات للأيام العادية، وألعابًا تأخذك إلى عوالم أخرى." : "We design apps for everyday life and games that take you into other worlds."}</p>
      <div class="hero-actions"><a class="cta" href="#products">{ar ? "استكشف أعمالنا" : "Explore our work"}</a><a class="play-link" href="#line-game">{ar ? "العب لا تقطع السطر" : "Play Don’t Break the Line"}</a></div>
    </div>
    <a class="credit" href={link("/the-duopoly")}>
      <small>{ar ? "من عالم اللعبة" : "Inside the game"}</small>
      <strong lang="en" dir="ltr">The Duopoly</strong>
      <span>{ar ? "ميناء أوريليس" : "Aurelis Harbour"}</span>
    </a>
  </div>
</section>
<div class="edition">
  <aside class="launch-strip" aria-label={ar ? "جديد سطر" : "New at SATER"}>
    <Image src={findTheSpy.icon} width={52} height={52} alt=""/>
    <div><strong>{ar ? "برا السالفة على Google Play" : "Find the Spy is on Google Play"}</strong><p>{ar ? "أول ألعاب SATER mini المستقلة للجلسات." : "The first standalone SATER mini party game."}</p></div>
    <nav><a href={link("/news/find-the-spy-on-google-play")}>{ar ? "إعلان اللعبة" : "Game announcement"}</a><a href={link("/news/introducing-sater-mini")}>{ar ? "عن SATER mini" : "Introducing SATER mini"}</a></nav>
  </aside>
  <section id="products" aria-labelledby="work-title">
    <div class="section-head"><h2 id="work-title">{ar ? "أعمال سطر" : "Our work"}</h2>
      <nav class="filters" aria-label={ar ? "مجموعات المنتجات" : "Product collections"}>
        {collections.map(group => <a data-filter={group.key} href={"#collection-" + group.key}>{group.label[locale]}</a>)}
      </nav>
    </div>
    {collections.map(group => (
      <div id={"collection-" + group.key} class="collection" data-group={group.key}>
        {group.items.map(product => (
          <article class="product">
            <a class="feature" href={link("/" + product.slug)}>
              <div class:list={["cover", {"mini-art": !product.feature}]} style={{"--ground":product.ground}}>
                <Image src={product.feature ?? product.icon} alt="" width={product.feature ? 840 : 190} format="webp" quality={85}/>
              </div>
              <div class="details">
                <p class="availability"><i class:list={[product.status]}></i>{product.status === "live" ? (ar ? "متاح الآن" : "Available now") : (ar ? "قيد التطوير" : "In development")}</p>
                <h3>{product.slug === "the-duopoly" && <Image class="title-icon" src={product.icon} width={44} height={44} alt=""/>}<bdi>{product.localizedName?.[locale] ?? (ar && product.root ? product.root : product.name)}</bdi></h3>
                <p class="tagline">{product.tagline[locale]}</p>
              </div>
            </a>
            {screens[product.slug] && <div class="capture-tools">
              <button type="button" class="capture" data-shot={product.slug} aria-haspopup="dialog">{screens[product.slug].label}</button>
              <dialog id={"shot-" + product.slug} aria-labelledby={"shot-title-" + product.slug}>
                <header><strong id={"shot-title-" + product.slug}>{screens[product.slug].label}</strong><form method="dialog"><button>{ar ? "إغلاق" : "Close"}</button></form></header>
                <img class="screen" loading="lazy" src={screens[product.slug].image.src} alt={screens[product.slug].label}/>
              </dialog>
            </div>}
          </article>
        ))}
      </div>
    ))}
  </section>
  <SaterRunner locale={locale}/>
  <section class="journal" aria-labelledby="news-title">
    <div class="journal-head"><h2 id="news-title">{ar ? "من الاستوديو" : "Studio journal"}</h2><a href={link("/news")}>{newsCopy[locale].all}</a></div>
    <div>{stories.map(story => <a class="story" href={link("/news/" + story.slug)}><time datetime={story.date}>{newsDate(story.date, locale)}</time><h3>{story.title[locale]}</h3></a>)}</div>
  </section>
</div>
<script>
  const filters = document.querySelectorAll<HTMLAnchorElement>("[data-filter]");
  const groups = document.querySelectorAll<HTMLElement>("[data-group]");
  function selectCollection() {
    const key = [...filters].find(item => item.hash === location.hash)?.dataset.filter ?? "games";
    for (const group of groups) group.hidden = group.dataset.group !== key;
    for (const item of filters) {
      if (item.dataset.filter === key) item.setAttribute("aria-current","true");
      else item.removeAttribute("aria-current");
    }
  }
  for (const item of filters) item.addEventListener("click", event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    history.pushState(null, "", item.hash);
    selectCollection();
  });
  selectCollection();
  window.addEventListener("hashchange", selectCollection);
  window.addEventListener("popstate", selectCollection);
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-shot]")) {
    const dialog = document.getElementById("shot-" + button.dataset.shot);
    if (dialog instanceof HTMLDialogElement) button.addEventListener("click", () => dialog.showModal());
  }
</script>
<style>
  .launch-strip{display:flex;align-items:center;gap:1rem;padding-block:1.1rem;border-bottom:1px solid var(--edge)}.launch-strip img{border-radius:9px}.launch-strip p{font-size:.91rem;color:var(--fg-dim)}.launch-strip nav{display:flex;align-items:center;gap:1.4rem;margin-inline-start:auto}.launch-strip a{font-size:.95rem;text-decoration:underline;text-underline-offset:.25em}@media(max-width:650px){.launch-strip{flex-wrap:wrap;gap:.65rem .85rem}.launch-strip nav{flex-basis:100%;margin:0}.launch-strip img{width:42px;height:42px}}
  .hero { isolation:isolate; position:relative; overflow:hidden; background:#10231f; color:#faf6e9; }
  .hero .panorama { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 57%; z-index:-3; }
  .veil { position:absolute; inset:0; z-index:-1; background:linear-gradient(to left,#0d201c 2%,rgba(11,32,28,.97) 18%,rgba(11,32,28,.85) 33%,rgba(11,32,28,.12) 65%,transparent 85%),linear-gradient(0deg,rgba(8,20,20,.78),transparent 37%); }
  :global(html[dir=ltr]) .veil { transform:scaleX(-1); }
  .hero-inner,.edition { width:var(--col); margin-inline:auto; }
  .hero-inner { display:flex; justify-content:space-between; align-items:center; gap:3rem; min-height:clamp(29rem,37vw,39rem); padding-block:clamp(3rem,4.6vw,5rem); }
  .mast { width:46%; }
  .location,.credit small { font-size:.88rem; font-weight:600; }
  .location { display:flex; gap:.7rem; align-items:center; color:#ece7d4; }
  .location::before { content:""; width:2rem; height:1px; background:#c7ad72; }
  h1 { font-size:clamp(3.4rem,6vw,6.1rem); font-weight:600; line-height:1.12; margin-block:1.1rem 1rem; }
  h1 span { color:#e8cc95; }
  .lede { max-width:30ch; font-size:clamp(1rem,1.32vw,1.24rem); line-height:1.7; color:#eceee5; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem 1.3rem; margin-block-start:1.7rem; }
  .play-link { display:inline-flex; min-height:44px; align-items:center; font-size:.95rem; text-decoration:underline; text-underline-offset:.33em; }
  .cta { display:inline-flex; padding:.62rem 1.4rem; align-items:center; min-height:44px; background:#f0e8d6; color:#12231e; border-radius:4px; font-weight:600; }
  .cta:hover { background:white; }
  .credit { color:white; align-self:flex-end; text-align:end; padding-inline-end:1rem; border-inline-end:2px solid #dfc391; display:grid; line-height:1.4; text-shadow:0 2px 12px #0c1717; }
  .credit strong { font-family:Georgia,serif; font-size:clamp(1.7rem,2.8vw,2.8rem); font-weight:400; }
  .credit span { font-size:.95rem; }
  #products { padding-block:clamp(2.2rem,4.4vw,4.5rem); }
  .section-head,.journal-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.6rem; }
  .section-head h2,.journal h2 { font-size:clamp(2rem,3.3vw,3rem); font-weight:600; }
  .filters { display:flex; border:1px solid var(--edge); padding:3px; border-radius:7px; gap:2px; }
  .filters a { padding:.4rem 1.05rem; font-size:.95rem; border-radius:4px; color:var(--fg-dim); }
  .filters a[aria-current] { background:var(--fg); color:var(--bg); }
  .collection { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(1rem,2vw,2rem); }
  .collection[hidden] { display:none; }
  .product { min-width:0; }
  .cover { aspect-ratio:2/1; overflow:hidden; background:var(--ground); border-radius:5px; }
  .cover img { width:100%; height:100%; object-fit:cover; }
  .mini-art { display:grid; place-items:center; }
  .mini-art img { width:auto; height:80%; border-radius:12%; }
  .details { padding-block-start:.9rem; }
  .availability { color:var(--fg-dim); font-size:.82rem; display:flex; align-items:center; gap:.45rem; }
  .availability i { width:.42rem; height:.42rem; border-radius:50%; background:#a67e3e; }
  .availability i.live { background:#56896d; }
  .product h3 { font-size:clamp(1.35rem,2vw,1.85rem); margin-block:.25rem; font-weight:600; }
  .product h3:has(.title-icon) {display:flex;align-items:center;gap:.55rem}
  .title-icon {width:2rem;height:2rem;border-radius:5px}
  .tagline { color:var(--fg-dim); line-height:1.55; }
  .feature:hover h3,.journal a:hover h3 { text-decoration:underline; text-underline-offset:.2em; }
  .capture,dialog button { cursor:pointer; font:inherit; color:var(--fg); }
  .capture { font-size:.875rem; background:transparent; padding:.45rem 0; border:0; text-decoration:underline; text-underline-offset:.3em; }
  dialog { position:fixed; margin:auto; max-width:92vw; max-height:92dvh; padding:1rem; background:var(--bg); border:1px solid var(--edge); color:var(--fg); }
  dialog::backdrop { background:#080d10bf; }
  dialog header { display:flex; align-items:center; gap:1rem; justify-content:space-between; margin-bottom:.8rem; }
  dialog button { background:transparent; border:1px solid var(--edge); padding:.3rem .8rem; }
  .screen { max-height:70dvh; max-width:min(75vw,36rem); width:auto; }
  .journal { display:grid; grid-template-columns:1fr 2fr; gap:3rem; padding-block:clamp(3rem,6vw,6rem); }
  .journal-head { display:block; }
  .journal-head a { text-decoration:underline; text-underline-offset:.3em; }
  .story { display:grid; grid-template-columns:auto 1fr; align-items:baseline; gap:1.6rem; padding-block:1.1rem; border-top:1px solid var(--edge); }
  .story h3 { font-size:1.15rem; font-weight:600; }
  .story time { font-size:.875rem; color:var(--fg-dim); }
  @media(max-width:740px) {
    .hero-inner { display:grid; gap:3rem; min-height:33rem; padding-block:2rem 1.25rem; }
    .hero .panorama { object-position:40% 65%; }
    .veil,:global(html[dir=ltr]) .veil { transform:none; background:linear-gradient(180deg,rgba(8,29,24,.97),rgba(10,31,26,.81) 41%,rgba(9,24,22,.15) 70%,rgba(8,23,20,.7)); }
    .mast { width:100%; }
    h1 { font-size:clamp(3.3rem,12.2vw,4.5rem); }
    .credit { justify-self:end; }
    .section-head { align-items:start; flex-direction:column; }
    .filters a { padding:.48rem .95rem; }
    .collection,.journal { grid-template-columns:1fr; gap:1.8rem; }
    .journal-head { display:flex; margin:0; }
    .story { grid-template-columns:1fr; gap:.25rem; }
  }
  @media(prefers-reduced-motion:no-preference) {
    .cover img { transition:transform .35s ease; }
    .feature:hover .cover img { transform:scale(1.025); }
  }
</style>
